# Steam Web API key — get it from https://steamcommunity.com/dev/apikey
# Rate limit: 100k requests/day 
STEAM_API_KEY=your_steam_api_key_here

# Stratz API key — get it from https://stratz.com/api (requires linking a Steam account)
# Rate limit: 7 req/sec, 140 req/min, 14k req/day
STRATZ_API_KEY=your_stratz_api_key_here

# --- Used by docker-compose to initialize the local Postgres container ---
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Used by the app/Alembic to build the SQLAlchemy connection URL ---
# If using the docker-compose DB above, mirror the same values here.
# If connecting to an external/managed Postgres instance, use its credentials instead.
DB_CONNECT_USER=your_db_user
DB_CONNECT_PASS=your_db_password
DB_CONNECT_NAME=postgres
DB_CONNECT_HOST=localhost
DB_CONNECT_PORT=5432
